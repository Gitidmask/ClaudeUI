{
  "$schema": "./node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run ensure-cli && vite",
    "beforeBuildCommand": "npm run ensure-cli && vite build",
    "devUrl": "http://localhost:5173",
    "distDir": "./dist"
  },
  "package": {
    "productName": "ClaudeUI",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "windows": [
      {
        "title": "ClaudeUI",
        "width": 1100,
        "height": 750,
        "minWidth": 600,
        "minHeight": 400,
        "titleBarStyle": "hiddenInset",
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws://localhost:* http://localhost:*"
    }
  }
}
