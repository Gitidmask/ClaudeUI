{
  "name": "claudui",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Daniel Liu <wellofspirit@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wellofspirit/ClaudeUI",
  "claudeCliVersion": "2.1.129",
  "ripgrepVersion": "14.1.1",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "tauri dev",
    "build": "npm run typecheck && npm run ensure-cli && tauri build",
    "ensure-cli": "node scripts/extract-cli.mjs && node patch/apply-all.mjs && node scripts/rebundle-cli.mjs",
    "update-cli": "node scripts/extract-cli.mjs --force && node patch/apply-all.mjs && node scripts/rebundle-cli.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "test": "vitest run --project unit --project component --project e2e",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "vitest run --project e2e",
    "test:integration": "vitest run --project integration",
    "test:git": "vitest run --project git",
    "test:git:changed": "vitest run --project git --changed",
    "test:ci": "vitest run --project unit --project component --project e2e --project git",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@mermaid-js/parser": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "^2.11.0",
    "express": "^4.21.0",
    "node-pty": "^1.0.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "@types/dompurify": "^3.2.0",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "ansi_up": "^6.0.6",
    "cron-parser": "^5.5.0",
    "diff": "^8.0.3",
    "dompurify": "^3.3.3",
    "mermaid": "^11.14.0",
    "prism-react-renderer": "^2.4.1",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.33.0",
    "undici": "^6",
    "uuid": "^13.0.0",
    "yaml": "^2.8.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@swc/core": "^1.15.21",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.11.2",
    "vite-plugin-tauri": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.2"
  }
}
